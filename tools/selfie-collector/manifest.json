{
  "manifest_version": 3,
  "name": "방종셀카 수집기 (AyaUke)",
  "version": "0.1.0",
  "description": "X/네이버 팬카페의 방종셀카 이미지를 로컬 dev 서버(/api/admin/selfie/ingest)로 수집·아카이빙합니다.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.twimg.com/*",
    "https://cafe.naver.com/*",
    "https://*.pstatic.net/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "방종셀카 수집기" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://cafe.naver.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
