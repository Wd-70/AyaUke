{
  "colors": {
    "light-text-primary": "#1F2937",
    "light-text-secondary": "rgba(31, 41, 55, 0.6)",
    "light-text-tertiary": "rgba(31, 41, 55, 0.4)",
    "dark-text-primary": "#F9FAFB",
    "dark-text-secondary": "rgba(249, 250, 251, 0.6)",
    "dark-text-tertiary": "rgba(249, 250, 251, 0.4)",
    "light-background": "rgba(255, 255, 255, 0.5)",
    "dark-background": "rgba(31, 41, 55, 0.5)",
    "icon-light": "rgba(31, 41, 55, 0.4)",
    "icon-dark": "rgba(249, 250, 251, 0.4)"
  },
  "fonts": {
    "title": {
      "family": "Inter, system-ui, sans-serif",
      "size": "18px",
      "lineHeight": "28px",
      "weight": "600",
      "letterSpacing": "normal"
    },
    "message": {
      "family": "Inter, system-ui, sans-serif",
      "size": "14px",
      "lineHeight": "20px",
      "weight": "400",
      "letterSpacing": "normal"
    },
    "tip": {
      "family": "Inter, system-ui, sans-serif",
      "size": "14px",
      "lineHeight": "20px",
      "weight": "400",
      "letterSpacing": "normal"
    }
  },
  "spacing": {
    "icon-size": "64px",
    "icon-margin-bottom": "16px",
    "title-margin-bottom": "8px",
    "message-margin-bottom": "24px",
    "container-padding-y": "48px",
    "container-padding-x": "24px",
    "tip-margin-top": "12px"
  },
  "effects": {
    "animation-duration": "0.3s",
    "animation-easing": "ease-out",
    "animation-properties": "opacity, transform"
  },
  "layout": {
    "max-width": "448px",
    "text-align": "center"
  }
}