{
  "colors": {
    "icon-light": "rgba(31, 41, 55, 0.4)",
    "icon-dark": "rgba(249, 250, 251, 0.4)",
    "title-light": "rgba(31, 41, 55, 0.6)",
    "title-dark": "rgba(249, 250, 251, 0.6)",
    "message-light": "rgba(31, 41, 55, 0.5)",
    "message-dark": "rgba(249, 250, 251, 0.5)",
